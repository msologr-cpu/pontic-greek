#Requires AutoHotkey v2.0
#SingleInstance Force

; ==============================================================================
; Восстановление апострофа в MS Word — Pontic Greek v5.1
; ==============================================================================
; ДЛЯ ЧЕГО ЭТА ПРОГРАММА
;
; Версии понтийской клавиатуры 4.0–5.0 содержали ошибку: при запуске они
; выключали в Word настройку «Заменять прямые кавычки парными» (умные кавычки).
;
; Это глобальная настройка Word — она сохраняется и продолжает действовать
; даже после закрытия нашей программы. Из-за неё апостроф на клавише «Э»
; начинал печатать прямой вертикальный штрих (') вместо правильных
; типографских ‘ и ’.
;
; Эта маленькая программа возвращает всё как было. Запускать один раз.
; После неё апостроф в Word снова печатается правильно: ‘κ’
;
; Понтийскую клавиатуру для этого устанавливать/запускать не нужно.
; ==============================================================================

APP := "Восстановление апострофа в Word"

; --- Word запущен? Работаем через него: изменения вступают в силу сразу ---
viaCom := false
try {
    w := ComObjActive("Word.Application")
    w.Options.AutoFormatAsYouTypeReplaceQuotes := true
    viaCom := true
}

; --- Правим реестр: чтобы настройка сохранилась и для будущих запусков ---
; Ключ AutoFormatAsYouTypeReplaceQuotes хранится в ветке Word\Options.
; Перебираем все установленные версии Office (14.0 = 2010, 16.0 = 2016+).
fixedVersions := ""
for ver in ["14.0", "15.0", "16.0"] {
    key := "HKEY_CURRENT_USER\Software\Microsoft\Office\" ver "\Word\Options"
    try {
        ; Пишем только если ветка этой версии Office реально существует
        RegRead(key, "")
    } catch {
        ; ветки нет — эта версия Office не установлена, пропускаем
    }
    try {
        RegWrite(1, "REG_DWORD", key, "AutoFormatAsYouTypeReplaceQuotes")
        fixedVersions .= (fixedVersions = "" ? "" : ", ") . ver
    }
}

msg := "Готово!`n`n"
    . "Апостроф в Word восстановлен.`n"
    . "Теперь при наборе получается правильно: ‘κ’`n`n"

if viaCom
    msg .= "• Word был открыт — изменения уже действуют.`n"
else
    msg .= "• Word закрыт — настройка применится при следующем запуске.`n"

if (fixedVersions != "")
    msg .= "• Обновлены настройки Office: " fixedVersions "`n"

msg .= "`nКак проверить:`n"
    .  "1. Откройте Word (если он был открыт — закройте и откройте заново).`n"
    .  "2. Нажмите клавишу «Э», затем «к», затем снова «Э».`n"
    .  "3. Должно получиться: ‘κ’`n`n"
    .  "Эту программу больше запускать не нужно."

MsgBox(msg, APP, "Iconi")
