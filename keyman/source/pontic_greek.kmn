c Pontic Greek Keyboard for Keyman
c Понтийская Греческая Раскладка — iOS / Android / Desktop
c
c Dead keys:
c   / (slash) → гачек (caron ˇ), бреве (breve ˘), две точки снизу (diaeresis below ̤)
c   On mobile: long-press for all diacritics
c
c Version: 1.0
c License: MIT

store(&VERSION) '10.0'
store(&NAME) 'Pontic Greek'
store(&COPYRIGHT) '© 2024-2026 Pontic Greek Keyboard Project'
store(&KEYBOARDVERSION) '1.0'
store(&TARGETS) 'mobile'
store(&LAYOUTFILE) 'pontic_greek.keyman-touch-layout'
store(&MESSAGE) 'Понтийская Греческая Клавиатура / Pontic Greek Keyboard'
store(&KMW_HELPTEXT) 'Pontic Greek keyboard with special diacritics: caron (ˇ), breve (˘), diaeresis below (̤)'

begin Unicode > use(main)

group(main) using keys

c =============================================================================
c Standard Greek layout — lowercase
c =============================================================================
+ [K_A] > U+03B1      c α alpha
+ [K_B] > U+03B2      c β beta
+ [K_G] > U+03B3      c γ gamma
+ [K_D] > U+03B4      c δ delta
+ [K_E] > U+03B5      c ε epsilon
+ [K_Z] > U+03B6      c ζ zeta
+ [K_H] > U+03B7      c η eta
+ [K_U] > U+03B8      c θ theta
+ [K_I] > U+03B9      c ι iota
+ [K_K] > U+03BA      c κ kappa
+ [K_L] > U+03BB      c λ lambda
+ [K_M] > U+03BC      c μ mu
+ [K_N] > U+03BD      c ν nu
+ [K_J] > U+03BE      c ξ xi
+ [K_O] > U+03BF      c ο omicron
+ [K_P] > U+03C0      c π pi
+ [K_R] > U+03C1      c ρ rho
+ [K_S] > U+03C3      c σ sigma (medial)
+ [K_W] > U+03C2      c ς sigma (final)
+ [K_T] > U+03C4      c τ tau
+ [K_Y] > U+03C5      c υ upsilon
+ [K_F] > U+03C6      c φ phi
+ [K_X] > U+03C7      c χ chi
+ [K_C] > U+03C8      c ψ psi
+ [K_V] > U+03C9      c ω omega

c =============================================================================
c Standard Greek layout — UPPERCASE
c =============================================================================
+ [SHIFT K_A] > U+0391    c Α Alpha
+ [SHIFT K_B] > U+0392    c Β Beta
+ [SHIFT K_G] > U+0393    c Γ Gamma
+ [SHIFT K_D] > U+0394    c Δ Delta
+ [SHIFT K_E] > U+0395    c Ε Epsilon
+ [SHIFT K_Z] > U+0396    c Ζ Zeta
+ [SHIFT K_H] > U+0397    c Η Eta
+ [SHIFT K_U] > U+03B8    c Θ Theta
+ [SHIFT K_I] > U+0399    c Ι Iota
+ [SHIFT K_K] > U+039A    c Κ Kappa
+ [SHIFT K_L] > U+039B    c Λ Lambda
+ [SHIFT K_M] > U+039C    c Μ Mu
+ [SHIFT K_N] > U+039D    c Ν Nu
+ [SHIFT K_J] > U+039E    c Ξ Xi
+ [SHIFT K_O] > U+039F    c Ο Omicron
+ [SHIFT K_P] > U+03A0    c Π Pi
+ [SHIFT K_R] > U+03A1    c Ρ Rho
+ [SHIFT K_S] > U+03A3    c Σ Sigma
+ [SHIFT K_T] > U+03A4    c Τ Tau
+ [SHIFT K_Y] > U+03A5    c Υ Upsilon
+ [SHIFT K_F] > U+03A6    c Φ Phi
+ [SHIFT K_X] > U+03A7    c Χ Chi
+ [SHIFT K_C] > U+03A8    c Ψ Psi
+ [SHIFT K_V] > U+03A9    c Ω Omega

c =============================================================================
c Tonos (acute accent) — dead key on semicolon (;) = Greek tonos key
c =============================================================================
+ [K_COLON] > dk(tonos)

dk(tonos) + [K_A] > U+03AC    c ά
dk(tonos) + [K_E] > U+03AD    c έ
dk(tonos) + [K_H] > U+03AE    c ή
dk(tonos) + [K_I] > U+03AF    c ί
dk(tonos) + [K_O] > U+03CC    c ό
dk(tonos) + [K_Y] > U+03CD    c ύ
dk(tonos) + [K_V] > U+03CE    c ώ

dk(tonos) + [SHIFT K_A] > U+0386    c Ά
dk(tonos) + [SHIFT K_E] > U+0388    c Έ
dk(tonos) + [SHIFT K_H] > U+0389    c Ή
dk(tonos) + [SHIFT K_I] > U+038A    c Ί
dk(tonos) + [SHIFT K_O] > U+038C    c Ό
dk(tonos) + [SHIFT K_Y] > U+038E    c Ύ
dk(tonos) + [SHIFT K_V] > U+038F    c Ώ

c Tonos + space = literal semicolon
dk(tonos) + [K_SPACE] > ';'
c Tonos + tonos = dialytika tonos (΅)
dk(tonos) + [K_COLON] > U+0385

c =============================================================================
c Dialytika (diaeresis) on ι and υ
c =============================================================================
c ϊ ϋ are produced via shift-; (΅ dead key) then vowel, or dedicated keys
+ [SHIFT K_COLON] > dk(dialytika)

dk(dialytika) + [K_I] > U+03CA    c ϊ
dk(dialytika) + [K_Y] > U+03CB    c ϋ
dk(dialytika) + [SHIFT K_I] > U+03AA    c Ϊ
dk(dialytika) + [SHIFT K_Y] > U+03AB    c Ϋ
dk(dialytika) + [K_SPACE] > U+0385    c ΅ dialytika tonos

c =============================================================================
c PONTIC DEAD KEY: / (slash) — гачек (caron), бреве (breve), две точки снизу
c =============================================================================
+ [K_SLASH] > dk(pontic)

c --- Гачек / Caron (U+030C) ---
dk(pontic) + [K_Z] > U+03B6 U+030C    c ζ̌ zeta caron
dk(pontic) + [K_X] > U+03C7 U+030C    c χ̌ chi caron
dk(pontic) + [K_S] > U+03C3 U+030C    c σ̌ sigma caron (medial)
dk(pontic) + [K_W] > U+03C2 U+030C    c ς̌ sigma caron (final)
dk(pontic) + [K_K] > U+03BA U+030C    c κ̌ kappa caron
dk(pontic) + [K_J] > U+03BE U+030C    c ξ̌ xi caron
dk(pontic) + [K_C] > U+03C8 U+030C    c ψ̌ psi caron

dk(pontic) + [SHIFT K_Z] > U+0396 U+030C    c Ζ̌
dk(pontic) + [SHIFT K_X] > U+03A7 U+030C    c Χ̌
dk(pontic) + [SHIFT K_S] > U+03A3 U+030C    c Σ̌
dk(pontic) + [SHIFT K_K] > U+039A U+030C    c Κ̌
dk(pontic) + [SHIFT K_J] > U+039E U+030C    c Ξ̌
dk(pontic) + [SHIFT K_C] > U+03A8 U+030C    c Ψ̌

c --- Бреве / Breve (U+0306) ---
dk(pontic) + [K_G] > U+03B3 U+0306    c γ̆ gamma breve
dk(pontic) + [SHIFT K_G] > U+0393 U+0306    c Γ̆

c --- Две точки снизу / Diaeresis Below (U+0324) ---
dk(pontic) + [K_A] > U+03B1 U+0324    c α̤
dk(pontic) + [K_O] > U+03BF U+0324    c ο̤
dk(pontic) + [SHIFT K_A] > U+0391 U+0324    c Α̤
dk(pontic) + [SHIFT K_O] > U+039F U+0324    c Ο̤

c --- Tonos + diaeresis below (chained: / then ; then vowel) ---
dk(pontic) + [K_COLON] > dk(pontic_tonos)

dk(pontic_tonos) + [K_A] > U+03AC U+0324    c ά̤
dk(pontic_tonos) + [K_O] > U+03CC U+0324    c ό̤
dk(pontic_tonos) + [SHIFT K_A] > U+0386 U+0324    c Ά̤
dk(pontic_tonos) + [SHIFT K_O] > U+038C U+0324    c Ό̤
dk(pontic_tonos) + [K_SPACE] > '/' ';'

c --- Pontic dead key + space = literal slash ---
dk(pontic) + [K_SPACE] > '/'

c =============================================================================
c Custom keys for touch layout (T_ prefix = touch-only keys)
c These map subkey IDs from the touch layout to their Unicode output
c =============================================================================

c --- Caron subkeys ---
+ [T_ZETA_CARON] > U+03B6 U+030C         c ζ̌
+ [T_CHI_CARON] > U+03C7 U+030C          c χ̌
+ [T_SIGMA_CARON] > U+03C3 U+030C        c σ̌
+ [T_SIGMA_FINAL_CARON] > U+03C2 U+030C  c ς̌
+ [T_KAPPA_CARON] > U+03BA U+030C        c κ̌
+ [T_XI_CARON] > U+03BE U+030C           c ξ̌
+ [T_PSI_CARON] > U+03C8 U+030C          c ψ̌

+ [T_ZETA_CARON_UC] > U+0396 U+030C      c Ζ̌
+ [T_CHI_CARON_UC] > U+03A7 U+030C       c Χ̌
+ [T_SIGMA_CARON_UC] > U+03A3 U+030C     c Σ̌
+ [T_KAPPA_CARON_UC] > U+039A U+030C     c Κ̌
+ [T_XI_CARON_UC] > U+039E U+030C        c Ξ̌
+ [T_PSI_CARON_UC] > U+03A8 U+030C       c Ψ̌

c --- Breve subkeys ---
+ [T_GAMMA_BREVE] > U+03B3 U+0306        c γ̆
+ [T_GAMMA_BREVE_UC] > U+0393 U+0306     c Γ̆

c --- Diaeresis below subkeys ---
+ [T_ALPHA_DBELOW] > U+03B1 U+0324       c α̤
+ [T_OMICRON_DBELOW] > U+03BF U+0324     c ο̤
+ [T_ALPHA_DBELOW_UC] > U+0391 U+0324    c Α̤
+ [T_OMICRON_DBELOW_UC] > U+039F U+0324  c Ο̤

c --- Tonos + diaeresis below subkeys ---
+ [T_ALPHA_TONOS_DBELOW] > U+03AC U+0324    c ά̤
+ [T_OMICRON_TONOS_DBELOW] > U+03CC U+0324  c ό̤
+ [T_ALPHA_TONOS_DBELOW_UC] > U+0386 U+0324 c Ά̤
+ [T_OMICRON_TONOS_DBELOW_UC] > U+038C U+0324 c Ό̤

c --- Sigma final subkey ---
+ [T_SIGMA_FINAL] > U+03C2               c ς

c --- Accented vowel subkeys ---
+ [T_ALPHA_TONOS] > U+03AC               c ά
+ [T_EPSILON_TONOS] > U+03AD             c έ
+ [T_ETA_TONOS] > U+03AE                 c ή
+ [T_IOTA_TONOS] > U+03AF               c ί
+ [T_IOTA_DIALYTIKA] > U+03CA            c ϊ
+ [T_IOTA_DIALYTIKA_TONOS] > U+0390     c ΐ
+ [T_OMICRON_TONOS] > U+03CC             c ό
+ [T_UPSILON_TONOS] > U+03CD             c ύ
+ [T_UPSILON_DIALYTIKA] > U+03CB         c ϋ
+ [T_UPSILON_DIALYTIKA_TONOS] > U+03B0  c ΰ
+ [T_OMEGA_TONOS] > U+03CE               c ώ

c =============================================================================
c Punctuation and numbers
c =============================================================================
+ [K_1] > '1'
+ [K_2] > '2'
+ [K_3] > '3'
+ [K_4] > '4'
+ [K_5] > '5'
+ [K_6] > '6'
+ [K_7] > '7'
+ [K_8] > '8'
+ [K_9] > '9'
+ [K_0] > '0'
+ [K_HYPHEN] > '-'
+ [K_EQUAL] > '='
+ [K_LBRKT] > '['
+ [K_RBRKT] > ']'
+ [K_BKSLASH] > '\'
+ [K_COMMA] > ','
+ [K_PERIOD] > '.'
+ [K_QUOTE] > U+0027
+ [K_BKQUOTE] > '`'
+ [K_SPACE] > ' '

+ [SHIFT K_1] > '!'
+ [SHIFT K_2] > '@'
+ [SHIFT K_3] > '#'
+ [SHIFT K_4] > '$'
+ [SHIFT K_5] > '%'
+ [SHIFT K_6] > '^'
+ [SHIFT K_7] > '&'
+ [SHIFT K_8] > '*'
+ [SHIFT K_9] > '('
+ [SHIFT K_0] > ')'
+ [SHIFT K_HYPHEN] > '_'
+ [SHIFT K_EQUAL] > '+'
+ [SHIFT K_LBRKT] > '{'
+ [SHIFT K_RBRKT] > '}'
+ [SHIFT K_BKSLASH] > '|'
+ [SHIFT K_COMMA] > '<'
+ [SHIFT K_PERIOD] > '>'
+ [SHIFT K_SLASH] > '?'
+ [SHIFT K_QUOTE] > '"'
+ [SHIFT K_BKQUOTE] > '~'
